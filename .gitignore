# Python cache
__pycache__/
*.pyc

# Virtual env
venv/
env/
.venv/

# VSCode 設定
.vscode/

# Pip/conda/build 產生的檔案
*.egg-info/
*.dist-info/
build/
site-packages/

# Track only these two experiment_log.txt files, ignore everything else
# under test_result/ (DFA graphs, pickles, PNGs, other runs' logs, etc. --
# regenerated by re-running experiments). Each pair un-ignores the directory
# itself (needed so git will look inside for the file negation below it --
# it won't recurse into an ignored directory otherwise) then the one file.
test_result/**
!test_result/realworld_0.8_1000/
!test_result/realworld_0.8_1000/experiment_log.txt
!test_result/regular_0.8_1000/
!test_result/regular_0.8_1000/experiment_log.txt
pickle/

# Regenerated from test_result/final_result/*/experiment_log.txt via
# analysis/parse_results.py -- intermediate pass-through, not the deliverable
# (that's analysis/plots/*.tex, which stay tracked).
analysis/summary_table.csv

# Vendored but unused (kept on disk, not referenced by any active code)
external_modules/interpretera/

# Vendored CXp solver: only language/explain.py (+ __init__.py) is actually
# used (loaded dynamically via importlib in src/learner/dfa_learner.py).
# Everything else here (main.py, dpi_explain.py, solve_maze.py, corpus/dna
# example data) is the upstream repo's own CLI tools/sample data, unused by
# this project -- ignored, with the two used files force-added instead.
external_modules/Explaining-FA/

# Test files
tests/

# Standalone log files from example scripts
examples/**/*.log
examples/**/*.txt

# Not tracked (kept locally only)
examples/RPNI/run_kllucb_comparison.py
examples/RPNI/run_wafer_param_ablation.py

# OS
.DS_Store
Thumbs.db

# Windows Zone.Identifier files (NTFS alternate data streams)
*:Zone.Identifier

CLAUDE.md
